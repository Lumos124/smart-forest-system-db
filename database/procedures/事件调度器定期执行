-- 删除原有事件
DROP EVENT IF EXISTS event_auto_generate_daily_reports;
DROP EVENT IF EXISTS event_auto_generate_weekly_reports;
DROP EVENT IF EXISTS event_auto_generate_monthly_reports;

-- 创建测试事件（每分钟执行一次，便于调试）
CREATE EVENT IF NOT EXISTS event_test_auto_generate
ON SCHEDULE
    EVERY 1 MINUTE
    STARTS NOW()
DO
    CALL sp_auto_generate_reports();

-- 或者创建正式的事件（每日执行）
CREATE EVENT IF NOT EXISTS event_auto_generate_daily
ON SCHEDULE
    EVERY 1 DAY
    STARTS CONCAT(CURRENT_DATE, ' 01:00:00')
DO
    CALL sp_auto_generate_reports();

-- 启用事件调度器
SET GLOBAL event_scheduler = ON;

-- 查看事件状态
SHOW EVENTS;
