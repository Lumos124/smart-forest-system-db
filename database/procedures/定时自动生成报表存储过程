DELIMITER $$
CREATE PROCEDURE sp_auto_generate_reports()
BEGIN
    -- 遍历所有生效的模板，按周期自动生成报表
    DECLARE done INT DEFAULT FALSE;
    DECLARE v_template_id INT;
    DECLARE v_cycle ENUM('日','周','月','季','年');
    DECLARE cur CURSOR FOR 
        SELECT 模板编号, 生成周期 
        FROM 报表模板 
        WHERE 是否生效 = TRUE AND 审核状态 = '通过';
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO v_template_id, v_cycle;
        IF done THEN LEAVE read_loop; END IF;
        
        -- 判断是否需要生成（如按日生成判断当天是否已生成）
        -- 调用 sp_generate_report 生成报表
    END LOOP;
    CLOSE cur;
END $$
DELIMITER ;
